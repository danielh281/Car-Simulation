<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>


<StackPane prefHeight="511.0" prefWidth="811.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dh.carsimulationassignment.SlideshowController">
   <children>
      <StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity">
         <children>
            <ImageView fx:id="carImage" fitHeight="250.0" fitWidth="560.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER" />
         </children>
      </StackPane>
      <Label fx:id="welcomeLabel" text="Welcome to Car Race!">
         <font>
            <Font name="Tahoma Bold" size="41.0" />
         </font>
      </Label>
   </children>
</StackPane>
